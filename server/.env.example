PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/foundnearme
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# AI (optional: the app falls back to keyword matching if empty)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Verification thresholds (0-100)
APPROVE_AT=75
REVIEW_AT=45
MAX_ATTEMPTS=2

# Seed script
ADMIN_EMAIL=admin@foundnearme.test
ADMIN_PASSWORD=admin12345
CAMPUS_LAT=34.33
CAMPUS_LNG=73.20
